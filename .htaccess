RewriteEngine On

RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/(about|services|portfolio|process|contact)\.html[\s?] [NC]
RewriteRule ^(about|services|portfolio|process|contact)\.html$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([A-Za-z0-9_-]+)$ $1.html [L]
